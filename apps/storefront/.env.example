# All three are required. getStorefrontEnv() throws without them, and the
# production build additionally needs the backend to be reachable because
# app/[locale]/layout.tsx fetches the catalog during prerender.
MEDUSA_BACKEND_URL=http://localhost:9000
# Created by: npm run seed:medusa
MEDUSA_PUBLISHABLE_KEY=
# Seals the order-confirmation cookie (AES-256-GCM). Use a unique value per
# environment; do not reuse the Medusa JWT or cookie secret.
STOREFRONT_SESSION_SECRET=
