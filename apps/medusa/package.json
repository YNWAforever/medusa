{
  "name": "@fotomax/medusa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./medusa-cli.cjs develop",
    "build": "node ./medusa-cli.cjs build",
    "start": "node ./medusa-cli.cjs start",
    "start:container": "medusa start --host 0.0.0.0 --port 9000",
    "seed": "node ./medusa-cli.cjs exec ./src/scripts/seed.ts",
    "ci:export-publishable-key": "node ./medusa-cli.cjs exec ./src/scripts/export-publishable-key.ts",
    "db:generate": "node ./medusa-cli.cjs db:generate",
    "db:migrate": "node ./medusa-cli.cjs db:migrate",
    "predeploy": "node ./medusa-cli.cjs db:migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js --runInBand --forceExit"
  },
  "dependencies": {
    "@fotomax/shared": "file:../../packages/shared",
    "@aws-sdk/client-s3": "3.1084.0",
    "@aws-sdk/s3-request-presigner": "3.1084.0",
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/caching-redis": "2.17.2",
    "@medusajs/cli": "2.17.2",
    "@medusajs/core-flows": "2.17.2",
    "@medusajs/event-bus-redis": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/locking-redis": "2.17.2",
    "@medusajs/medusa": "2.17.2",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/workflow-engine-redis": "2.17.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "^2.17.2",
    "@swc/core": "^1.7.28",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.5",
    "jest": "^29.7.0",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "vite": "^5.4.14",
    "vitest": "^3.2.0"
  }
}
